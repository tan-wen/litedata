# Copy this file to .env and replace every development secret before exposing ports.
MYSQL_ROOT_PASSWORD=change-this-root-password
DOLPHINSCHEDULER_DB_PASSWORD=generated-by-setup
PLATFORM_DB_USER=platform_app
PLATFORM_DB_PASSWORD=change-this-platform-password
PLATFORM_ENCRYPTION_KEY=change-this-to-a-random-32-character-minimum-key
PLATFORM_ADMIN_PASSWORD=change-this-admin-password
PLATFORM_INTERNAL_TOKEN=change-this-to-a-random-32-character-minimum-token

# Scheduler bootstrap credentials. The generated token is written to deploy/runtime/engine.json.
DOLPHINSCHEDULER_ADMIN_PASSWORD=change-this-ds-admin-password
DOLPHINSCHEDULER_URL=http://dolphinscheduler:12345/dolphinscheduler
DOLPHINSCHEDULER_PROJECT_CODE=0
DOLPHINSCHEDULER_TOKEN=

# Doris has separate reader and writer identities. Modeling uses the writer with CREATE_PRIV on warehouse.*.
# The writer secret never reaches pages, data API queries, or the platform claim response.
DORIS_USER=platform_reader
DORIS_PASSWORD=change-this-doris-reader-password
DORIS_WRITER_USER=platform_writer
DORIS_WRITER_PASSWORD=change-this-doris-writer-password
DORIS_JDBC_URL=jdbc:mysql://doris:9030/warehouse
# Worker-reachable Stream Load HTTP endpoint for the all-in-one BE.
DORIS_LOAD_URL=doris:8040

# Compose development ports
PLATFORM_PORT=8080
MYSQL_PORT=3306
DEMO_MYSQL_PORT=3307
DORIS_FE_HTTP_PORT=8030
DORIS_FE_MYSQL_PORT=9030
DOLPHINSCHEDULER_PORT=12345
